<Window x:Class="CAIME.Windows.UserGuidesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:mdwpf="clr-namespace:Markdig.Wpf;assembly=Markdig.Wpf"
        mc:Ignorable="d"
        Title="User Guides"
        Width="900"
        Height="700"
        MinWidth="480"
        MinHeight="320"
        WindowStartupLocation="CenterOwner"
        WindowStyle="ThreeDBorderWindow"
        Background="{StaticResource BackgroundDarkV1Brush}">

    <!--
        Dark-theme overrides for the markdown rendered by Markdig.Wpf. Its shipped styles
        bake in light-theme colours (black headings, light-grey code backgrounds, a black
        thematic-break line), which are unreadable on a dark page. These styles are keyed
        by the same ComponentResourceKeys the renderer uses, so they win over the theme
        defaults. Document-level colours (page background + body text) are set in code.
    -->
    <Window.Resources>
        <!--
            Body paragraphs. Unlike the other keys below, Markdig.Wpf ships no default
            for ParagraphStyleKey in its generic.xaml, so without this override the
            renderer logs a "Resource not found" warning for every paragraph it emits.
        -->
        <Style x:Key="{ComponentResourceKey TypeInTargetAssembly={x:Type mdwpf:Styles}, ResourceId=ParagraphStyleKey}" TargetType="{x:Type Paragraph}">
            <Setter Property="Margin" Value="0,0,0,10" />
        </Style>

        <!-- Headings -->
        <Style x:Key="{ComponentResourceKey TypeInTargetAssembly={x:Type mdwpf:Styles}, ResourceId=Heading1StyleKey}" TargetType="{x:Type Paragraph}">
            <Setter Property="Foreground" Value="#F0F0F0" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="FontSize" Value="30" />
            <Setter Property="Margin" Value="0,18,0,8" />
        </Style>
        <Style x:Key="{ComponentResourceKey TypeInTargetAssembly={x:Type mdwpf:Styles}, ResourceId=Heading2StyleKey}" TargetType="{x:Type Paragraph}">
            <Setter Property="Foreground" Value="#F0F0F0" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="FontSize" Value="24" />
            <Setter Property="Margin" Value="0,16,0,6" />
        </Style>
        <Style x:Key="{ComponentResourceKey TypeInTargetAssembly={x:Type mdwpf:Styles}, ResourceId=Heading3StyleKey}" TargetType="{x:Type Paragraph}">
            <Setter Property="Foreground" Value="#F0F0F0" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="FontSize" Value="19" />
            <Setter Property="Margin" Value="0,14,0,4" />
        </Style>
        <Style x:Key="{ComponentResourceKey TypeInTargetAssembly={x:Type mdwpf:Styles}, ResourceId=Heading4StyleKey}" TargetType="{x:Type Paragraph}">
            <Setter Property="Foreground" Value="#F0F0F0" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontSize" Value="16" />
            <Setter Property="Margin" Value="0,12,0,4" />
        </Style>
        <Style x:Key="{ComponentResourceKey TypeInTargetAssembly={x:Type mdwpf:Styles}, ResourceId=Heading5StyleKey}" TargetType="{x:Type Paragraph}">
            <Setter Property="Foreground" Value="#F0F0F0" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Margin" Value="0,12,0,4" />
        </Style>
        <Style x:Key="{ComponentResourceKey TypeInTargetAssembly={x:Type mdwpf:Styles}, ResourceId=Heading6StyleKey}" TargetType="{x:Type Paragraph}">
            <Setter Property="Foreground" Value="#B8B8B8" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Margin" Value="0,12,0,4" />
        </Style>

        <!-- Inline code and fenced code blocks -->
        <Style x:Key="{ComponentResourceKey TypeInTargetAssembly={x:Type mdwpf:Styles}, ResourceId=CodeStyleKey}" TargetType="{x:Type Run}">
            <Setter Property="Background" Value="#2D2D2D" />
            <Setter Property="Foreground" Value="#E8E8E8" />
            <Setter Property="FontFamily" Value="Consolas, Lucida Sans Typewriter, Courier New" />
        </Style>
        <Style x:Key="{ComponentResourceKey TypeInTargetAssembly={x:Type mdwpf:Styles}, ResourceId=CodeBlockStyleKey}" TargetType="{x:Type Paragraph}">
            <Setter Property="Background" Value="#2D2D2D" />
            <Setter Property="Foreground" Value="#E8E8E8" />
            <Setter Property="FontFamily" Value="Consolas, Lucida Sans Typewriter, Courier New" />
            <Setter Property="Padding" Value="12,8,12,8" />
        </Style>

        <!-- Block quotes -->
        <Style x:Key="{ComponentResourceKey TypeInTargetAssembly={x:Type mdwpf:Styles}, ResourceId=QuoteBlockStyleKey}" TargetType="{x:Type Section}">
            <Setter Property="BorderBrush" Value="#686868" />
            <Setter Property="BorderThickness" Value="4,0,0,0" />
            <Setter Property="Foreground" Value="#9E9E9E" />
            <Setter Property="Padding" Value="16,0,0,0" />
        </Style>

        <!-- Links -->
        <Style x:Key="{ComponentResourceKey TypeInTargetAssembly={x:Type mdwpf:Styles}, ResourceId=HyperlinkStyleKey}" TargetType="{x:Type Hyperlink}">
            <Setter Property="Foreground" Value="#3395D6" />
        </Style>

        <!-- Horizontal rule -->
        <Style x:Key="{ComponentResourceKey TypeInTargetAssembly={x:Type mdwpf:Styles}, ResourceId=ThematicBreakStyleKey}" TargetType="{x:Type Line}">
            <Setter Property="Stretch" Value="Fill" />
            <Setter Property="Stroke" Value="#686868" />
        </Style>

        <!-- Highlighted (==marked==) text: keep yellow background readable -->
        <Style x:Key="{ComponentResourceKey TypeInTargetAssembly={x:Type mdwpf:Styles}, ResourceId=MarkedStyleKey}" TargetType="{x:Type Span}">
            <Setter Property="Background" Value="#FFF500" />
            <Setter Property="Foreground" Value="#101010" />
        </Style>

        <!-- Tables -->
        <Style x:Key="{ComponentResourceKey TypeInTargetAssembly={x:Type mdwpf:Styles}, ResourceId=TableStyleKey}" TargetType="{x:Type Table}">
            <Setter Property="BorderBrush" Value="#686868" />
            <Setter Property="BorderThickness" Value="0,0,1,1" />
            <Setter Property="CellSpacing" Value="0" />
        </Style>
        <Style x:Key="{ComponentResourceKey TypeInTargetAssembly={x:Type mdwpf:Styles}, ResourceId=TableCellStyleKey}" TargetType="{x:Type TableCell}">
            <Setter Property="BorderBrush" Value="#686868" />
            <Setter Property="BorderThickness" Value="1,1,0,0" />
            <Setter Property="Padding" Value="6,3,6,3" />
        </Style>
        <Style x:Key="{ComponentResourceKey TypeInTargetAssembly={x:Type mdwpf:Styles}, ResourceId=TableHeaderStyleKey}" TargetType="{x:Type TableRow}">
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Background" Value="#2D2D2D" />
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Navigation toolbar -->
        <Border Grid.Row="0"
                Background="{StaticResource BackgroundDarkV5Brush}"
                Padding="8 6">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Button x:Name="BackButton"
                        Grid.Column="0"
                        Content="◀ Back"
                        Style="{StaticResource DarkButton}"
                        Padding="10 3"
                        Margin="0 0 5 0"
                        Click="Back_Click" />

                <Button x:Name="ForwardButton"
                        Grid.Column="1"
                        Content="Forward ▶"
                        Style="{StaticResource DarkButton}"
                        Padding="10 3"
                        Margin="0 0 5 0"
                        Click="Forward_Click" />

                <Button x:Name="HomeButton"
                        Grid.Column="2"
                        Content="Start Page"
                        Style="{StaticResource DarkButton}"
                        Padding="10 3"
                        Click="Home_Click" />

                <TextBlock x:Name="TitleText"
                           Grid.Column="3"
                           VerticalAlignment="Center"
                           HorizontalAlignment="Right"
                           Margin="10 0 4 0"
                           FontSize="16"
                           FontFamily="Agency FB"
                           Foreground="White"
                           TextTrimming="CharacterEllipsis" />
            </Grid>
        </Border>

        <!-- Rendered markdown -->
        <FlowDocumentScrollViewer x:Name="DocViewer"
                                  Grid.Row="1"
                                  Background="{StaticResource BackgroundDarkV0Brush}"
                                  IsToolBarVisible="False"
                                  VerticalScrollBarVisibility="Auto" />
    </Grid>
</Window>
