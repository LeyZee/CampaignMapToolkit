<Window x:Class="CAIME.Windows.CreateNewSwatchWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:CAIME"
        mc:Ignorable="d"
        Title="{Binding WindowTitle, FallbackValue=Create_new_swatch}"
        Height="Auto"
        Width="Auto"
        MinWidth="325"
        MaxWidth="800"
        MinHeight="175"
        MaxHeight="175"
        WindowStartupLocation="CenterOwner"
        SizeToContent="WidthAndHeight"
        WindowStyle="ToolWindow"
        Background="{StaticResource BackgroundDarkV1Brush}">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" MinWidth="20" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" MaxWidth="600" />
            <ColumnDefinition Width="*" MinWidth="20" />
        </Grid.ColumnDefinitions>

        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="1"
                   Grid.Column="1"
                   Margin="0 5 10 5"
                   Text="Name:"
                   Foreground="White"
                   VerticalAlignment="Center" />

        <TextBox Grid.Row="1"
                 Grid.Column="2"
                 Margin="0 5"
                 MinWidth="200"
                 VerticalAlignment="Center"
                 Text="{Binding NewSwatchName, FallbackValue=new_swatch_name}"
                 Style="{StaticResource DarkTextBox}" />

        <TextBlock Grid.Row="2"
                   Grid.Column="1"
                   Margin="0 5 10 5"
                   Text="Is sea?"
                   IsEnabled="{Binding IsSeaEnabled}"
                   Foreground="White"
                   VerticalAlignment="Center" />

        <StackPanel Grid.Row="2"
                    Grid.Column="2"
                    Margin="5"
                    Orientation="Horizontal"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center">
            
            <RadioButton x:Name="yesBtn"
                         Content="Yes"
                         Margin="5"
                         IsChecked="{Binding IsSea}"
                         IsEnabled="{Binding IsSeaEnabled}"
                         Foreground="White" />

            <RadioButton x:Name="noBtn"
                         Content="No"
                         Margin="5"
                         IsChecked="{Binding IsSea, Converter={StaticResource InverseBoolConverter}, FallbackValue=True}"
                         IsEnabled="{Binding IsSeaEnabled}"
                         Foreground="White" />

        </StackPanel>

        <!--TextBlock Grid.Row="3"
                   Grid.Column="1"
                   Margin="0 5 10 5"
                   Text="Colour:"
                   Foreground="White"
                   VerticalAlignment="Center" /-->

        <!--local:ColourPickControl x:Name="colourPicker"
                                 Grid.Row="3"
                                 Grid.Column="2" /-->

        <Separator Grid.Row="4"
                   Grid.Column="0"
                   Grid.ColumnSpan="4"
                   Margin="0 5"
                   Background="{StaticResource BackgroundDarkV3Brush}" />

        <StackPanel Grid.Row="5"
                    Grid.Column="0"
                    Grid.ColumnSpan="4"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right" >

            <StackPanel Grid.Column="1"
                        Margin="5"
                        Orientation="Horizontal"
                        VerticalAlignment="Bottom"
                        HorizontalAlignment="Right">

                <!--Button Grid.Column="0"
                        Content="Random colour"
                        Padding="15 3"
                        Margin="0 5 50 5"
                        HorizontalAlignment="Left"
                        Style="{StaticResource DarkButton}"
                        Click="RandomColourButton_Click"/-->

                <Button x:Name="confirmButton"
                        Content="Confirm"
                        Padding="15 3"
                        Margin="0 5 0 5"
                        HorizontalAlignment="Right"
                        Style="{StaticResource DarkButton}"
                        Click="ConfirmButton_Click"/>

                <Button x:Name="cancelButton"
                        Content="Cancel"
                        IsCancel="True"
                        Padding="15 3"
                        Margin="2 5 0 5"
                        HorizontalAlignment="Right"
                        Style="{StaticResource DarkButton}"
                        Click="CancelButton_Click"/>

            </StackPanel>
        </StackPanel>

    </Grid>
    
</Window>
