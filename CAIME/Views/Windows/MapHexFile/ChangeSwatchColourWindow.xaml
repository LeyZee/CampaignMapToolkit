<Window x:Class="CAIME.Windows.ChangeSwatchColourWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:CAIME"
        mc:Ignorable="d"
        Title="Change swatch colour"
        MinHeight="210"
        MinWidth="300"
        MaxHeight="250"
        MaxWidth="210"
        SizeToContent="WidthAndHeight"
        WindowStyle="ToolWindow"
        Background="{StaticResource BackgroundDarkV1Brush}">
    
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="1"
                   Grid.Column="1"
                   Margin="0 5 10 5"
                   Text="New colour:"
                   Foreground="White"
                   VerticalAlignment="Center" />

        <local:ColourPickControl x:Name="colourPicker"
                                 Grid.Row="1"
                                 Grid.Column="2" />

        <Separator Grid.Row="2"
                   Grid.Column="0"
                   Grid.ColumnSpan="4"
                   Margin="0 5"
                   Background="{StaticResource BackgroundDarkV3Brush}" />

        <StackPanel Grid.Row="3"
                    Grid.Column="0"
                    Grid.ColumnSpan="4"
                    Margin="5"
                    Orientation="Horizontal"
                    VerticalAlignment="Bottom"
                    HorizontalAlignment="Right">

            <Button x:Name="confirmButton"
                    Content="Confirm"
                    Padding="15 3"
                    Margin="0 5 0 5"
                    Style="{StaticResource DarkButton}"
                    Click="ConfirmButton_Click"/>

            <Button x:Name="cancelButton"
                    Content="Cancel"
                    IsCancel="True"
                    Padding="15 3"
                    Margin="2 5 0 5"
                    Style="{StaticResource DarkButton}"
                    Click="CancelButton_Click"/>

        </StackPanel>
    </Grid>
    
</Window>
