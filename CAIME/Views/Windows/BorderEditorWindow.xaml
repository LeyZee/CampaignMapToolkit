<Window x:Class="CAIME.BorderEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:CAIME"
        mc:Ignorable="d"
        Height="700" 
        Width="1800"
        WindowStyle="None"
        Closing="WindowClosing"
        Background="{StaticResource BackgroundDarkV4Brush}" 
        Foreground="White"
        Style="{DynamicResource DarkBorderEditor}">

    <Window.Resources>

        <Style x:Key="DarkBorderEditor" TargetType="{x:Type Window}">
            <Setter Property="Background" Value="{StaticResource BackgroundDarkV1Brush}" />
            <Setter Property="BorderBrush" Value="{StaticResource BackgroundDarkV2Brush}" />
            <Setter Property="WindowChrome.WindowChrome">
                <Setter.Value>
                    <WindowChrome CaptionHeight="34"
                              CornerRadius="5"
                              GlassFrameThickness="0"
                              NonClientFrameEdges="None"
                              ResizeBorderThickness="5"
                              UseAeroCaptionButtons="False" />
                </Setter.Value>
            </Setter>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Window}">
                        <Grid>
                            <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1 34 1 1" >
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="44" ShadowDepth="0" Color="Black" />
                                </Border.Effect>
                                <AdornerDecorator>
                                    <ContentPresenter />
                                </AdornerDecorator>
                            </Border>

                            <Separator VerticalAlignment="Top" Background="{StaticResource BackgroundDarkV0Brush}" Margin="0 34 0 0" />

                            <DockPanel x:Name="PART_WindowHeader"
                                   Height="34"
                                   VerticalAlignment="Top"
                                   LastChildFill="False">

                                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">

                                    <Image Source="/CAIME;component/Resources/Border_editor_icon.ico"
                                       WindowChrome.IsHitTestVisibleInChrome="True"
                                       MaxWidth="24" Margin="5"
                                       RenderOptions.BitmapScalingMode="Fant"
                                       MouseLeftButtonDown="Menu_MouseLeftButtonDown"
                                       MouseRightButtonUp="Menu_MouseRightButtonUp"/>

                                    <Label Content="Border editor" Foreground="White" Margin="5"/>
                                    <Menu Style="{StaticResource DarkMenu}" VerticalAlignment="Center" WindowChrome.IsHitTestVisibleInChrome="True">
                                        <MenuItem Header="File">
                                            <MenuItem Header="Load" Click="LoadClicked"/>
                                            <MenuItem Header="Save" Click="SaveClicked"/>
                                            <MenuItem Header="Exit" Click="CloseClicked"/>
                                        </MenuItem>
                                        <MenuItem Header="Border part" IsEnabled="{Binding BothRegionsSelected}">
                                            <MenuItem 
                                                Header="Add"
                                                Click="AddPartClicked"/>
                                            <MenuItem 
                                                Header="Delete"
                                                 IsEnabled="{Binding BPartEnabled}"
                                                Click="DeletePartClicked"/>
                                            <MenuItem 
                                                Header="Change border facing"
                                                 IsEnabled="{Binding BPartEnabled}"
                                                Click="ChangeFacingClicked"/>
                                        </MenuItem>
                                        <MenuItem Header="Border point" IsEnabled="{Binding BPartEnabled}">
                                            <MenuItem 
                                                Header="Insert"
                                                Click="InsertPointClicked"
                                                ToolTip="Insert border point behind the current selected one. If no border point is selected it will be inserted prior to the first one."/>
                                            <MenuItem 
                                                Header="Delete"
                                                IsEnabled="{Binding BPointEnabled}"
                                                Click="DeletePointClicked"/>
                                            <MenuItem 
                                                Header="Unselect"
                                                IsEnabled="{Binding BPointEnabled}"
                                                Click="UnselectPointClicked"/>
                                        </MenuItem>
                                        <MenuItem Header="Visualization" IsEnabled="{Binding BPointEnabled}">
                                            <MenuItem Header="Refresh" Click="RefreshVisClicked"/>
                                        </MenuItem>
                                        <MenuItem Header="Help">
                                            <MenuItem Header="Show manual" Click="ShowManualClicked"/>
                                        </MenuItem>
                                    </Menu>
                                </StackPanel>

                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Margin="0 0 5 0" >
                                    <Button Margin="0 0 0 10" Content="▁" Style="{StaticResource ControlButtonDark}"
                                        MinWidth="{Binding ActualHeight, RelativeSource={RelativeSource Self}}"
                                        WindowChrome.IsHitTestVisibleInChrome="True" FontSize="10" Click="MinimiseClicked" />
                                    <Button Margin="0 0 0 10" Content="❐" Style="{StaticResource ControlButtonDark}"
                                        MinWidth="{Binding ActualHeight, RelativeSource={RelativeSource Self}}"
                                        WindowChrome.IsHitTestVisibleInChrome="True" FontSize="14" Click="MaximiseClicked" />
                                    <Button Margin="0 0 0 10" Content="✕" Style="{StaticResource CloseControlButton}"
                                        MinWidth="{Binding ActualHeight, RelativeSource={RelativeSource Self}}"
                                        WindowChrome.IsHitTestVisibleInChrome="True" Click="CloseClicked" />
                                </StackPanel>
                            </DockPanel>
                        </Grid>

                        <ControlTemplate.Triggers>
                            <Trigger Property="WindowState" Value="Maximized">
                                <Setter Property="Margin" Value="50" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2*"/>
            <ColumnDefinition Width="20*"/>
            <ColumnDefinition Width="5*"/>
            <ColumnDefinition Width="20*"/>
            <ColumnDefinition Width="5*"/>
            <ColumnDefinition Width="80*"/>
            <ColumnDefinition Width="2*"/>
            <ColumnDefinition Width="30*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="2*"/>
            <RowDefinition Height="96*"/>
            <RowDefinition Height="2*"/>
        </Grid.RowDefinitions>
        <StackPanel Grid.Column="1" Grid.Row="1">
            <Label 
                Foreground="White"
                VerticalAlignment="Center"
                Content="Source region"/>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="50*"/>
                    <ColumnDefinition Width="20*"/>
                    <ColumnDefinition Width="30*"/>
                </Grid.ColumnDefinitions>

                <Button 
                    Style="{StaticResource DarkButton}"
                    Grid.Column="0"
                    Click="SelectFromClicked"
                    Content="Select"/>
                <Button 
                    Style="{StaticResource DarkButton}"
                    Grid.Column="2"
                    Click="ClearFromClicked"
                    Content="Clear"/>
            </Grid>
            <StackPanel Orientation="Horizontal" Height="28">
                <Rectangle
                    Margin="3"
                    VerticalAlignment="Center"
                    Height="15"
                    Width="15"
                    Fill="{Binding RegFromColour, Converter={StaticResource ColourConverter}}"/>
                <Label
                    Content="{Binding RegFromName}"
                    VerticalAlignment="Center"
                    Foreground="White"/>
            </StackPanel>
            <Button Style="{StaticResource DarkButton}" 
                    Margin="2 20 2 10"
                    HorizontalAlignment="Center"
                    Click="InvertClicked"
                    IsEnabled="{Binding RegToSelected}"
                    ToolTip="Invert source region and target region"
                    Width="20" Height="24">
                <!--Image is 200x244-->
                <Button.Background>
                    <ImageBrush ImageSource="/Resources/Invert_icon.png"/>
                </Button.Background>
            </Button>

            <Label 
                Foreground="White"
                VerticalAlignment="Center"
                Content="Target region"/>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="50*"/>
                    <ColumnDefinition Width="20*"/>
                    <ColumnDefinition Width="30*"/>
                </Grid.ColumnDefinitions>

                <Button 
                    Style="{StaticResource DarkButton}"
                    Grid.Column="0"
                    Click="SelectToClicked"
                    Content="Select"/>
                <Button 
                    Style="{StaticResource DarkButton}"
                    Grid.Column="2"
                    Click="ClearToClicked"
                    Content="Clear"/>
            </Grid>
            <StackPanel Orientation="Horizontal"  Height="28">
                <Rectangle
                    Margin="3"
                    VerticalAlignment="Center"
                    Height="15"
                    Width="15"
                    Fill="{Binding RegToColour, Converter={StaticResource ColourConverter}}"/>
                <Label
                    Content="{Binding RegToName}"
                    VerticalAlignment="Center"
                    Foreground="White"/>
            </StackPanel>

            <Separator Margin="2 20 2 10"/>

            <Label 
                Foreground="White"
                VerticalAlignment="Center"
                Content="Border part"/>

            <ListView
                Margin="0 5 0 0"
                Height="150"
                Background="{StaticResource BackgroundDarkV3Brush}"
                SelectionMode="Single"
                Foreground="White"
                ItemsSource="{Binding BPartList}" 
                SelectedIndex="{Binding BPartSelected}"/>
        </StackPanel>

        <Grid Grid.Row="1" Grid.Column="3">
            <Grid.RowDefinitions>
                <RowDefinition Height="5*"/>
                <RowDefinition Height="95*"/>
            </Grid.RowDefinitions>

            <Label
                Grid.Row="0"
                Foreground="White"
                VerticalAlignment="Center"
                Content="Border point"/>

            <ListView
                Grid.Row="1"
                Background="{StaticResource BackgroundDarkV3Brush}"
                SelectionMode="Single"
                Foreground="White"
                ItemsSource="{Binding BPointList}" 
                SelectedIndex="{Binding BPointSelected}"/>
        </Grid>
        <Border Grid.Column="5" Grid.Row="1" x:Name="visulizationImage"
                BorderThickness="1" BorderBrush="#FFA2A2A2">
            <Image
                Margin="5" 
                Source="{Binding Bitmap}" 
                Visibility="{Binding ShowBitmap}"/>
        </Border>
        <Grid Grid.Column="7" Grid.Row="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="15*"/>
                <RowDefinition Height="45*"/>
                <RowDefinition Height="40*"/>
            </Grid.RowDefinitions>
            <StackPanel Grid.Row="0">
                <Label 
                
                Foreground="White"
                VerticalAlignment="Center"
                Content="Border point"/>
                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0 10 0 0">
                    <Label Content="X:" Foreground="White"/>
                    <TextBox
                    Text="{Binding XCoord}"
                    IsEnabled="{Binding BPointEnabled}"
                    Width="50"
                    Height="27"
                    Style="{StaticResource DarkTextBox}"/>
                    <StackPanel Orientation="Vertical" >
                        <Button 
                        Width="15" 
                        Height="13"
                        IsEnabled="{Binding BPointEnabled}"
                        Click="IncreaseXClicked">
                            <Button.Background>
                                <ImageBrush ImageSource="/Resources/Increase_icon.png"/>
                            </Button.Background>
                        </Button>
                        <Button 
                        Width="15" 
                        Height="13"
                        IsEnabled="{Binding BPointEnabled}"
                        Click="DecreaseXClicked">
                            <Button.Background>
                                <ImageBrush ImageSource="/Resources/Decrease_icon.png"/>
                            </Button.Background>
                        </Button>
                    </StackPanel>
                    <Label Content="Y:" Foreground="White" Margin="60 0 0 0"/>
                    <TextBox
                    Text="{Binding YCoord}"
                    IsEnabled="{Binding BPointEnabled}"
                    Width="50"
                    Height="27"
                    Style="{StaticResource DarkTextBox}"/>
                    <StackPanel Orientation="Vertical" >
                        <Button 
                        Width="15" 
                        Height="13"
                        IsEnabled="{Binding BPointEnabled}"
                        Click="IncreaseYClicked">
                            <Button.Background>
                                <ImageBrush ImageSource="/Resources/Increase_icon.png"/>
                            </Button.Background>
                        </Button>
                        <Button 
                        Width="15" 
                        Height="13"
                        IsEnabled="{Binding BPointEnabled}"
                        Click="DecreaseYClicked">
                            <Button.Background>
                                <ImageBrush ImageSource="/Resources/Decrease_icon.png"/>
                            </Button.Background>
                        </Button>
                    </StackPanel>
                </StackPanel>
                <Separator Grid.Row="0" Margin="2 20 2 10"/>
            </StackPanel>
            <StackPanel Grid.Row="1" x:Name="visualizationSP">
                <Grid Margin="5">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="47*"/>
                        <ColumnDefinition Width="18*"/>
                        <ColumnDefinition Width="35*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition/>
                        <RowDefinition/>
                        <RowDefinition/>
                        <RowDefinition/>
                        <RowDefinition/>
                        <RowDefinition/>
                    </Grid.RowDefinitions>

                    <Label 
                        Grid.Column="0" Grid.Row="0" 
                        Content="Border:" 
                        Foreground="White" 
                        Margin="5"/>
                    <Rectangle 
                        Grid.Column="1" Grid.Row="0"
                        Width="25" Height="25" 
                        Fill="{Binding BorderBrush}"
                        Margin="5"/>
                    <Button 
                        Grid.Column="2" Grid.Row="0"
                        Style="{StaticResource DarkButton}"
                        Margin="5"
                        Content="Change colour"
                        Click="ChangeBorderColour"/>

                    <Label 
                        Grid.Column="0" Grid.Row="1" 
                        Content="Current border point:" 
                        Foreground="White" 
                        Margin="5"/>
                    <Rectangle 
                        Grid.Column="1" Grid.Row="1"
                        Width="25" Height="25" 
                        Fill="{Binding BorderPBrush}"
                        Margin="5"/>
                    <Button 
                        Grid.Column="2" Grid.Row="1"
                        Style="{StaticResource DarkButton}"
                        Margin="5"
                        Content="Change colour"
                        Click="ChangeBorderPColour"/>

                    <Label 
                        Grid.Column="0" Grid.Row="2" 
                        Content="Other border parts:" 
                        Foreground="White" 
                        Margin="5"/>
                    <Rectangle 
                        Grid.Column="1" Grid.Row="2"
                        Width="25" Height="25" 
                        Fill="{Binding OtherPartBrush}"
                        Margin="5"/>
                    <Button 
                        Grid.Column="2" Grid.Row="2"
                        Style="{StaticResource DarkButton}"
                        Margin="5"
                        Content="Change colour"
                        Click="ChangeOtherPartColour"/>

                    <Label 
                        Grid.Column="0" Grid.Row="3" 
                        Content="Complementary border:" 
                        Foreground="White" 
                        Margin="5"/>
                    <Rectangle 
                        Grid.Column="1" Grid.Row="3"
                        Width="25" Height="25" 
                        Fill="{Binding ComplementaryBrush}"
                        Margin="5"/>
                    <Button 
                        Grid.Column="2" Grid.Row="3"
                        Style="{StaticResource DarkButton}"
                        Margin="5"
                        Content="Change colour"
                        Click="ChangeComplementaryColour"/>

                    <Label 
                        Grid.Column="0" Grid.Row="4" 
                        Content="Source region:" 
                        Foreground="White" 
                        Margin="5"/>
                    <Rectangle 
                        Grid.Column="1" Grid.Row="4"
                        Width="25" Height="25" 
                        Fill="{Binding RegFromBrush}"
                        Margin="5"/>
                    <Button 
                        Grid.Column="2" Grid.Row="4"
                        Style="{StaticResource DarkButton}"
                        Margin="5"
                        Content="Change colour"
                        Click="ChangeRegFromColour"/>

                    <Label 
                        Grid.Column="0" Grid.Row="5" 
                        Content="Target region:" 
                        Foreground="White" 
                        Margin="5"/>
                    <Rectangle 
                        Grid.Column="1" Grid.Row="5"
                        Width="25" Height="25" 
                        Fill="{Binding RegToBrush}"
                        Margin="5"/>
                    <Button 
                        Grid.Column="2" Grid.Row="5"
                        Style="{StaticResource DarkButton}"
                        Margin="5"
                        Content="Change colour"
                        Click="ChangeRegToColour"/>
                </Grid>
                <TextBlock 
                       Text="Changing colours doesn't affect the database, only this visualization." 
                       TextWrapping="WrapWithOverflow"
                       TextAlignment="Center" 
                       Foreground="White"
                       Margin="5"/>
            </StackPanel>
            <Label Grid.Row="2" 
                   Content="{Binding Status}"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Bottom" 
                   Foreground="{Binding StatusColour}"/>
        </Grid>
    </Grid>
</Window>
