<Window x:Class="CAIME.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:CAIME"
        mc:Ignorable="d"
        Title="Campaign AI Map Editor"
        Icon="/CAIME;component/Resources/icon.ico"
        MinHeight="640"
        MinWidth="760"
        Height="Auto"
        Width="Auto"
        WindowStyle="None"
        WindowStartupLocation="CenterScreen"
        Style="{DynamicResource DarkMainWindow}">

    <!-- Custom window style (includes menu, caption, control buttons etc) -->
    <Window.Resources>
        <ResourceDictionary>
            <Style x:Key="DarkMainWindow" TargetType="{x:Type Window}">
                <Setter Property="Background" Value="{StaticResource BackgroundDarkV1Brush}" />
                <Setter Property="BorderBrush" Value="{StaticResource BackgroundDarkV2Brush}" />
                <Setter Property="WindowChrome.WindowChrome">
                    <Setter.Value>
                        <WindowChrome CaptionHeight="34"
                                      CornerRadius="5"
                                      GlassFrameThickness="0"
                                      NonClientFrameEdges="None"
                                      ResizeBorderThickness="5"
                                      UseAeroCaptionButtons="False" />
                    </Setter.Value>
                </Setter>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type Window}">
                            <Grid Name="grid">
                                <Border Background="{TemplateBinding Background}"
                                        BorderBrush="{TemplateBinding BorderBrush}"
                                        BorderThickness="1 34 1 1" >
                                    <!--<Border.Effect>
                                        <DropShadowEffect BlurRadius="44" ShadowDepth="0" Color="Black" />
                                    </Border.Effect>-->
                                    <AdornerDecorator>
                                        <ContentPresenter />
                                    </AdornerDecorator>
                                </Border>

                                <Separator VerticalAlignment="Top" Background="{StaticResource BackgroundDarkV0Brush}" Margin="0 34 0 0" />

                                <DockPanel x:Name="PART_WindowHeader"
                                           Height="34"
                                           VerticalAlignment="Top"
                                           LastChildFill="False">

                                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">

                                        <!-- App Icon -->
                                        <Image Source="{TemplateBinding Icon}"
                                               WindowChrome.IsHitTestVisibleInChrome="True"
                                               x:Name="iconImg" MaxWidth="24" Margin="5"
                                               RenderOptions.BitmapScalingMode="Fant"
                                               MouseLeftButtonDown="Menu_MouseLeftButtonDown"
                                               MouseRightButtonUp="Menu_MouseRightButtonUp"/>

                                        <!-- Caption -->
                                        <TextBlock Text="{TemplateBinding Title}" VerticalAlignment="Center" Foreground="White" />

                                        <!-- Menu -->
                                        <local:MenuControl x:Name="MenuControl"
                                                    Grid.Row="0"
                                                    Height="{Binding ActualHeight, ElementName=iconImg}"
                                                    WindowChrome.IsHitTestVisibleInChrome="True"/>
                                    </StackPanel>

                                    <!-- Control Buttons -->
                                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Margin="0 0 5 0" >
                                        <!-- Minimise Button -->
                                        <Button Margin="0 0 0 10" Content="▁" Style="{StaticResource ControlButtonDark}"
                                                MinWidth="{Binding ActualHeight, RelativeSource={RelativeSource Self}}"
                                                WindowChrome.IsHitTestVisibleInChrome="True" FontSize="10" Click="Minimise_Click" />
                                        <!-- Maximise Button -->
                                        <Button Margin="0 0 0 10" Content="❐" Style="{StaticResource ControlButtonDark}"
                                                MinWidth="{Binding ActualHeight, RelativeSource={RelativeSource Self}}"
                                                WindowChrome.IsHitTestVisibleInChrome="True" FontSize="14" Click="Maximise_Click" />
                                        <!-- Close Button -->
                                        <Button Margin="0 0 0 10" Content="✕" Style="{StaticResource CloseControlButton}"
                                                MinWidth="{Binding ActualHeight, RelativeSource={RelativeSource Self}}"
                                                WindowChrome.IsHitTestVisibleInChrome="True" Click="Close_Click" />
                                    </StackPanel>
                                </DockPanel>
                            </Grid>

                            <ControlTemplate.Triggers>
                                <Trigger Property="WindowState" Value="Maximized">
                                    <Setter Property="Margin" Value="50" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <!-- Editor -->
    <local:Editor x:Name="EditorControl"/>
</Window>
