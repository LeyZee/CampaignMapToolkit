<Window x:Class="CAIME.BordersExportOptionsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:CAIME"
        mc:Ignorable="d"
        Width="700"
        Height="400"
        WindowStyle="None"
        Background="{StaticResource BackgroundDarkV4Brush}" 
        Foreground="White"
        ResizeMode="NoResize"
        Style="{DynamicResource DarkBorderExportDialog}">

    <Window.Resources>
        <Style x:Key="DarkBorderExportDialog" TargetType="{x:Type Window}">
            <Setter Property="Background" Value="{StaticResource BackgroundDarkV1Brush}" />
            <Setter Property="BorderBrush" Value="{StaticResource BackgroundDarkV2Brush}" />
            <Setter Property="WindowChrome.WindowChrome">
                <Setter.Value>
                    <WindowChrome CaptionHeight="34"
                              CornerRadius="5"
                              GlassFrameThickness="0"
                              NonClientFrameEdges="None"
                              ResizeBorderThickness="5"
                              UseAeroCaptionButtons="False" />
                </Setter.Value>
            </Setter>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Window}">
                        <Grid>
                            <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1 34 1 1" >
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="44" ShadowDepth="0" Color="Black" />
                                </Border.Effect>
                                <AdornerDecorator>
                                    <ContentPresenter />
                                </AdornerDecorator>
                            </Border>

                            <Separator VerticalAlignment="Top" Background="{StaticResource BackgroundDarkV0Brush}" Margin="0 34 0 0" />

                            <DockPanel x:Name="PART_WindowHeader"
                                   Height="34"
                                   VerticalAlignment="Top"
                                   LastChildFill="False">

                                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">

                                    <Image Source="/CAIME;component/Resources/icon.ico"
                                       WindowChrome.IsHitTestVisibleInChrome="True"
                                       MaxWidth="24" Margin="5"
                                       RenderOptions.BitmapScalingMode="Fant"
                                       MouseLeftButtonDown="Menu_MouseLeftButtonDown"
                                       MouseRightButtonUp="Menu_MouseRightButtonUp"/>

                                    <Label Content="Select borders to export" Foreground="White" Margin="5"/>
                                </StackPanel>

                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Margin="0 0 5 0" >
                                    <Button Margin="0 0 0 10" Content="✕" Style="{StaticResource CloseControlButton}"
                                        MinWidth="{Binding ActualHeight, RelativeSource={RelativeSource Self}}"
                                        WindowChrome.IsHitTestVisibleInChrome="True" Click="CloseClicked" />
                                </StackPanel>
                            </DockPanel>
                        </Grid>

                        <ControlTemplate.Triggers>
                            <Trigger Property="WindowState" Value="Maximized">
                                <Setter Property="Margin" Value="50" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="90*"/>
            <RowDefinition Height="10*"/>
        </Grid.RowDefinitions>

        <DataGrid Grid.Row="0"
                  Margin="0 0 0 10"
                  ItemsSource="{Binding ExportOptions}"
                  AutoGenerateColumns="True"
                  Style="{DynamicResource DarkDataGrid}"/>
        
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition/>
                <ColumnDefinition/>
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>
            <Button Grid.Column="0" Content="Cancel" Margin="20 1 20 1" Style="{StaticResource DarkButton}" Click="CancelClicked"/>
            <Button Grid.Column="1" Content="Reset" Margin="20 1 20 1" Style="{StaticResource DarkButton}" Click="ResetClicked" ToolTip="Reset all export options to default options of this game."  />
            <Button Grid.Column="2" Content="Export" Margin="20 1 20 1" Style="{StaticResource DarkButton}" Click="ExportClicked"/>
        </Grid>
    </Grid>
</Window>
