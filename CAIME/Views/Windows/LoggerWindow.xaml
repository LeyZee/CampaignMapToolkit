<Window x:Class="CAIME.Windows.LoggerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:CAIME.Windows"
        mc:Ignorable="d"
        Title="Logger messages stack"
        Height="450"
        Width="800"
        Background="{StaticResource BackgroundDarkV1Brush}"
        WindowStartupLocation="CenterOwner"
        WindowStyle="ToolWindow">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../Templates/LogItemTemplate.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
    
        <ListBox Grid.Column="0"
                 Grid.Row="0"
                 x:Name="logsContainerListBox"
                 Background="{StaticResource BackgroundDarkV1Brush}"
                 ItemTemplate="{StaticResource LogItemTemplate}"
                 ItemsSource="{Binding MessagesStack}"
                 SelectionMode="Extended">

            <ListBox.InputBindings>
                <KeyBinding Key="C" Modifiers="Ctrl" Command="ApplicationCommands.Copy"/>
            </ListBox.InputBindings>

            <ListBox.CommandBindings>
                <CommandBinding Command="ApplicationCommands.Copy" Executed="CopySelected_Executed"/>
            </ListBox.CommandBindings>

            <ListBox.ContextMenu>
                <ContextMenu>
                    <MenuItem Header="Copy selected" Click="CopySelected_Click"/>
                    <MenuItem Header="Copy all" Click="CopyAll_Click"/>
                </ContextMenu>
            </ListBox.ContextMenu>

            <ListBox.ItemsPanel>
                <ItemsPanelTemplate>
                    <VirtualizingStackPanel Margin="10"
                                            Orientation="Vertical"/>
                </ItemsPanelTemplate>
            </ListBox.ItemsPanel>
        </ListBox>

        <StackPanel Grid.Column="0"
                    Grid.Row="1"
                    Orientation="Horizontal"
                    Background="{StaticResource BackgroundDarkV0Brush}"
                    HorizontalAlignment="Right">

            <Button Content="Copy all"
                    Padding="20 5"
                    Margin="5"
                    Style="{StaticResource DarkButton}"
                    Click="CopyAll_Click"/>

            <Button Content="Clear"
                    Padding="20 5"
                    Margin="5"
                    Style="{StaticResource DarkButton}"
                    Click="Clear_Click"/>

        </StackPanel>
        
    </Grid>

</Window>
