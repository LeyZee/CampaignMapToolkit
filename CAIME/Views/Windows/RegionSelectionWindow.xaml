<Window x:Class="CAIME.RegionSelectionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:CAIME"
        mc:Ignorable="d"
        Height="600" Width="300"
        Title="{Binding Title}"
        Background="{StaticResource BackgroundDarkV4Brush}" 
        Foreground="White"
        Visibility="{Binding Visibility}"
        Topmost="True"
        Closing="WindowClosing">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../Templates/RegionListItemTemplate.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="95*"/>
            <RowDefinition Height="5*"/>
        </Grid.RowDefinitions>
        <ListView
            Grid.Row="0"
            Background="{StaticResource BackgroundDarkV3Brush}"
            SelectionMode="Single"
            ItemsSource="{Binding RegionList}" 
            SelectedItem="{Binding RegionSelected}"
            ItemTemplate="{StaticResource RegionListItemTemplate}">
            <ListView.ItemContainerStyle>
                <Style TargetType="{x:Type ListBoxItem}" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                    <EventSetter Event="MouseDoubleClick" Handler="RegionDoubleClick"/>
                </Style>
            </ListView.ItemContainerStyle>
        </ListView>
        <CheckBox
                Grid.Row="1"
                Content="Hide empty"
                Foreground="White"
                VerticalAlignment="Center"
                IsChecked="{Binding HideEmpty}"/>
        <Button
                Style="{StaticResource DarkButton}"
                Grid.Row="1"
                Content="Confirm"
                HorizontalAlignment="Right"
                Margin="0 2 5 2"
                Width="55"
                Click="ConfirmClicked"
                IsEnabled="{Binding ConfirmEnabled}"/>
    </Grid>

</Window>
