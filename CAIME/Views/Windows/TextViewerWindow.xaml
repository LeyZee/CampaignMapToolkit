<Window x:Class="CAIME.Windows.TextViewerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Text Viewer"
        Width="640"
        Height="480"
        MinWidth="400"
        MinHeight="280"
        WindowStartupLocation="CenterOwner"
        WindowStyle="ThreeDBorderWindow"
        Background="{StaticResource BackgroundDarkV1Brush}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Content area -->
        <Grid Grid.Row="0" Margin="10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Header -->
            <StackPanel Grid.Row="0" Margin="10 10 10 0">
                <TextBlock x:Name="HeaderText"
                           FontSize="22"
                           FontFamily="Agency FB"
                           Foreground="White" />
                <Separator Margin="0 5 0 0"
                           Background="{StaticResource BackgroundDarkV3Brush}" />
            </StackPanel>

            <!-- Content -->
            <ScrollViewer Grid.Row="1"
                          Margin="10 8 10 8"
                          VerticalScrollBarVisibility="Auto"
                          Style="{StaticResource DarkScrollViewer}">
                <TextBlock x:Name="ContentText"
                           FontSize="13"
                           FontFamily="Agency FB"
                           Foreground="White"
                           TextWrapping="Wrap" />
            </ScrollViewer>
        </Grid>

        <!-- Footer -->
        <Border Grid.Row="1"
                Background="{StaticResource BackgroundDarkV5Brush}">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Label x:Name="AcceptedLabel"
                       Content="Accepted"
                       Foreground="#FF22CC66"
                       FontWeight="SemiBold"
                       Visibility="Collapsed"
                       VerticalAlignment="Center"
                       Padding="10 3"
                       Margin="5 3" />
                <Button x:Name="AcceptButton"
                        Visibility="Collapsed"
                        Background="{StaticResource BackgroundBlueV0Brush}"
                        Style="{StaticResource DarkButton}"
                        Padding="10 3"
                        Margin="5 3" />
                <Button x:Name="CloseButton"
                        Content="Close"
                        Style="{StaticResource DarkButton}"
                        Padding="10 3"
                        Margin="5 3" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
