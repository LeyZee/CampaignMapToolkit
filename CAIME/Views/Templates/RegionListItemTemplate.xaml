<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:local="clr-namespace:CAIME">

    <DataTemplate x:Key="RegionListItemTemplate">
        <StackPanel Orientation="Horizontal" Margin="0 3 0 5">
            <Rectangle
                Margin="3"
                VerticalAlignment="Center"
                Height="17"
                Width="17"
                Fill="{Binding Colour, Converter={StaticResource ColourConverter}}"/>
            <Border BorderBrush="{x:Null}" Height="20" Margin="5 0 0 2">
                <TextBlock
                Text="{Binding Name}"
                VerticalAlignment="Center"
                Foreground="White"/>
            </Border>
            
        </StackPanel>
        
    </DataTemplate>
</ResourceDictionary>
