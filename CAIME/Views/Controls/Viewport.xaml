<UserControl x:Class="CAIME.Viewport"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:hx="http://helix-toolkit.org/wpf/SharpDX"
             xmlns:local="clr-namespace:CAIME"
             mc:Ignorable="d"
             d:DesignHeight="450"
             d:DesignWidth="800">

    <hx:Viewport3DX x:Name="viewport"
                    BackgroundColor="{StaticResource BackgroundDarkV0}"
                    EffectsManager="{Binding EffectsManager}"
                    Camera="{Binding Camera}"
                    UseDefaultGestures="False"
                    ShowViewCube="False"
                    Orthographic="True"
                    EnableSSAO="False"
                    FXAALevel="None"
                    EnableAutoOctreeUpdate="True"
                    EnableRenderFrustum="True"
                    EnableD2DRendering="False"
                    EnableMouseButtonHitTest="True"
                    IsRotationEnabled="False"
                    IsThreeFingerPanningEnabled="False"
                    IsTouchRotateEnabled="False"
                    IsChangeFieldOfViewEnabled="False"
                    IsShadowMappingEnabled="False"
                    PreviewMouseDown="Viewport_PreviewMouseDown"
                    MouseMove="Viewport_MouseMove"
                    MouseUp="Viewport_MouseUp"
                    MouseWheel="Viewport_MouseWheel"
                    FrameRateText="{Binding Source={x:Static local:LoggerViewModel.Instance},
                                            Path=FPS,
                                            Mode=TwoWay}">

        <hx:Viewport3DX.InputBindings>
            <MouseBinding Command="{Binding LeftClick}" Gesture="LeftClick"/>
            <MouseBinding Command="hx:ViewportCommands.Zoom" Gesture="MiddleClick"/>
            <MouseBinding Command="hx:ViewportCommands.Pan" Gesture="RightClick"/>
        </hx:Viewport3DX.InputBindings>
        
        <!-- Invisible grid outline for hit test optimisation -->
        <hx:MeshGeometryModel3D CullMode="Back"
                                IsHitTestVisible="True"
                                Material="{Binding GridOutlineMaterial}"
                                Geometry="{Binding GridOutlineGeometry}" />

    </hx:Viewport3DX>
</UserControl>
