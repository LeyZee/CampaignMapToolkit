<UserControl x:Class="CAIME.ColourPickControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:CAIME"
             mc:Ignorable="d"
             Width="Auto"
             Height="Auto"
             d:DesignHeight="120"
             d:DesignWidth="210">
    
    <!--xmlns:colorpicker="clr-namespace:ColorPicker;assembly=ColorPicker"-->

    <Grid VerticalAlignment="Center"
          HorizontalAlignment="Stretch">

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="24"/>
            <RowDefinition Height="24"/>
            <RowDefinition Height="24"/>
            <RowDefinition Height="24"/>
            <RowDefinition Height="24"/>
            <RowDefinition Height="24"/>
        </Grid.RowDefinitions>

        <!--<colorpicker:SquarePicker Grid.RowSpan="6"
                                  Grid.Column="0"
                                  HorizontalAlignment="Left"
                                  x:Name="colorPicker"
                                  Margin="10"
                                  SelectedColor="{Binding SelectedColor, Mode=TwoWay}"/>-->

        <Label Grid.Row="1"
               Grid.Column="1"
               FontSize="10"
               Content="Red:"
               Foreground="White"
               FontWeight="Medium"
               VerticalAlignment="Center"/>

        <TextBox Grid.Row="1"
                 Grid.Column="2"
                 Text="{Binding TextRed, FallbackValue=255, Mode=TwoWay}"
                 Style="{StaticResource DarkTextBox}"
                 FontSize="12"
                 MinWidth="37"
                 MaxWidth="37"
                 VerticalAlignment="Center"/>

        <Label Grid.Row="2"
               Grid.Column="1"
               FontSize="10"
               Content="Green:"
               Foreground="White"
               FontWeight="Medium"
               VerticalAlignment="Center"/>

        <TextBox Grid.Row="2"
                 Grid.Column="2"
                 Text="{Binding TextGreen, FallbackValue=255, Mode=TwoWay}"
                 Style="{StaticResource DarkTextBox}"
                 FontSize="12"
                 MinWidth="37"
                 MaxWidth="37"
                 VerticalAlignment="Center"/>

        <Label Grid.Row="3"
               Grid.Column="1"
               FontSize="10"
               Content="Blue:"
               Foreground="White"
               FontWeight="Medium"
               VerticalAlignment="Center"/>

        <TextBox Grid.Row="3"
                 Grid.Column="2"
                 Text="{Binding TextBlue, FallbackValue=255, Mode=TwoWay}"
                 Style="{StaticResource DarkTextBox}"
                 FontSize="12"
                 MinWidth="37"
                 MaxWidth="37"
                 VerticalAlignment="Center"/>

        <Label Grid.Row="4"
               Grid.Column="1"
               FontSize="10"
               Content="Preview:"
               Foreground="White"
               FontWeight="Medium"
               VerticalAlignment="Center"/>

        <RadioButton Grid.Row="4"
                     Grid.Column="2"
                     Style="{StaticResource DarkSwatch}"
                     Background="{Binding PreviewSwatch}"
                     IsEnabled="False"
                     Width="22"
                     Height="22"
                     VerticalAlignment="Center"/>

    </Grid>

</UserControl>
