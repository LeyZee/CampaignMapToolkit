<UserControl x:Class="CAIME.Editor"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:CAIME"
             mc:Ignorable="d" 
             d:DesignHeight="450"
             d:DesignWidth="800"
             Loaded="Control_Loaded">

    <Grid Background="Transparent">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="25"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="30"/>
            <ColumnDefinition Width="*" MinWidth="200"/>
            <ColumnDefinition Width="5"/>
            <ColumnDefinition Width="250" MinWidth="180" MaxWidth="600"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Row="0"
                Grid.Column="0"
                Background="{StaticResource BackgroundDarkV5Brush}" />

        <!-- Toolbar -->
        <local:Toolbar x:Name="toolbar"
                       Grid.Row="1"
                       Grid.Column="0"
                       IsEnabled="{Binding Source={x:Static local:AppStateContext.Instance},
                                           Path=IsToolbarEnabled}"/>
        
        <!-- Quick tool settings -->
        <Border Grid.Row="0"
                Grid.Column="1"
                Background="{StaticResource BackgroundDarkV5Brush}">
            
            <DockPanel Margin="5"
                       VerticalAlignment="Center"
                       HorizontalAlignment="Left">

                <!-- Paint brush size -->
                <TextBlock Text="Brush size:"
                           VerticalAlignment="Center"
                           Foreground="White"
                           Visibility="{Binding Source={x:Static local:AppStateContext.Instance},
                                                Path=BrushSizeSliderVisibility}"/>

                <TextBlock Margin="5 0"
                           Width="15"
                           VerticalAlignment="Center"
                           Foreground="White"
                           Visibility="{Binding Source={x:Static local:AppStateContext.Instance},
                                                Path=BrushSizeSliderVisibility}"
                           Text="{Binding ElementName=brushSizeSlider,
                                          Path=Value}"/>

                <Slider Name="brushSizeSlider"
                        Minimum="1"
                        Maximum="10"
                        LargeChange="1"
                        TickFrequency="1"
                        Width="100"
                        ToolTip="Change brush size"
                        VerticalAlignment="Center"
                        IsSnapToTickEnabled="True"
                        Visibility="{Binding Source={x:Static local:AppStateContext.Instance},
                                             Path=BrushSizeSliderVisibility}"
                        IsEnabled="{Binding Source={x:Static local:AppStateContext.Instance},
                                            Path=IsBrushSizeSliderEnabled}"
                        Value="{Binding BrushSize,
                                        Mode=TwoWay}" />

                <!-- Background image opacity -->
                <TextBlock Text="Image opacity:"
                           VerticalAlignment="Center"
                           Foreground="White"/>

                <TextBlock Margin="5 0"
                           Width="27"
                           Foreground="White"
                           VerticalAlignment="Center"
                           Text="{Binding ElementName=backImgOpacitySlider,
                                          Path=Value}"/>

                <Slider Name="backImgOpacitySlider"
                        Minimum="0"
                        Maximum="100"
                        LargeChange="10"
                        TickFrequency="1"
                        Width="100"
                        Margin="0 0 5 0"
                        VerticalAlignment="Center"
                        IsSnapToTickEnabled="True"
                        ToolTip="Change background image opacity"
                        PreviewKeyUp="BackImgOpacitySlider_PreviewKeyUp"
                        PreviewMouseUp="BackImgOpacitySlider_PreviewMouseUp"
                        IsEnabled="{Binding Source={x:Static local:AppStateContext.Instance},
                                            Path=IsBackImgSliderEnabled}"
                        Value="100" />

                <Button IsEnabled="{Binding ElementName=backImgOpacitySlider,
                                            Path=IsEnabled}"
                        Style="{StaticResource DarkButton}"
                        ToolTip="Remove background image"
                        VerticalAlignment="Center"
                        Click="ClearImage_Click">
                    
                    <Image Source="{StaticResource ClearImage}"
                           Margin="2"
                           Width="20"
                           RenderOptions.BitmapScalingMode="Fant"/>
                </Button>
                
                <TextBlock Text="Flood Fill source:"
                           VerticalAlignment="Center"
                           Margin="5 0"
                           Foreground="White"
                           Visibility="{Binding Source={x:Static local:AppStateContext.Instance},
                                                Path=FloodFillSourceVisibility}"/>

                <ComboBox Style="{StaticResource DarkFlatComboBox}"
                          MinWidth="100"
                          SelectionChanged="FloodFillSource_SelectionChanged"
                          SelectedItem="{Binding SelectedFloodFillSource,
                                                 Mode=TwoWay}"
                          ItemsSource="{Binding FloodFillLayersSource}"
                          Visibility="{Binding Source={x:Static local:AppStateContext.Instance},
                                               Path=FloodFillSourceVisibility}"/>


            </DockPanel>
        </Border>

        <!-- Viewport -->
        <local:Viewport x:Name="viewport"
                        Grid.Row="1"
                        Grid.Column="1"
                        IsEnabled="{Binding Source={x:Static local:AppStateContext.Instance},
                                            Path=IsViewportEnabled}"/>

        <!-- Sidebar resize handle -->
        <GridSplitter Grid.Row="0"
                      Grid.RowSpan="2"
                      Grid.Column="2"
                      Width="5"
                      HorizontalAlignment="Stretch"
                      VerticalAlignment="Stretch"
                      Background="{StaticResource BackgroundDarkV3Brush}"
                      Cursor="SizeWE"
                      ResizeBehavior="PreviousAndNext"
                      ResizeDirection="Columns"/>

        <!-- Sidebar -->
        <local:Sidebar x:Name="sidebar"
                       Grid.Row="0"
                       Grid.RowSpan="2"
                       Grid.Column="3"
                       IsEnabled="{Binding Source={x:Static local:AppStateContext.Instance},
                                           Path=IsSidebarEnabled}"/>

        <!-- Logger -->
        <local:LoggerRibbon Grid.Row="2"
                            Grid.ColumnSpan="4"/>
    
    </Grid>
</UserControl>
